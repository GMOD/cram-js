digraph cram {
  rankdir=TB
  compound=true
  newrank=true
  fontname="Helvetica"
  node [shape=box style=rounded fontname="Helvetica" fontsize=10 margin="0.14,0.08"]
  edge [fontname="Helvetica" fontsize=9 color="#555555"]

  query [label="IndexedCramFile.getRecordsForRange(seqId, start, end)"]
  crai  [label="CraiIndex — read .crai, gunzip, parse\n→ slice entries covering the range"]
  cont  [label="CramContainer — read container header +\ncompression header block (memoized per query)"]
  cache [label="CramFile.featureCache\nhit?" shape=diamond style="" height=0.75 width=2.2]
  out   [label="filter, then viewAsPairs mate pass\n→ CramRecord[]"]

  subgraph cluster_fill {
    label="cache fill — once per slice, keyed container:slice"
    color="#999999" fontcolor="#666666" fontsize=10 style=dashed

    req [label="CramSlice.buildDecodeRequest\none read of the slice's whole block region\n→ bytes + numbers only (SliceDecodeRequest)"]

    subgraph cluster_decode {
      label="pool worker if Worker + Blob URL, else in-process"
      color="#3f6fb5" fontcolor="#3f6fb5" fontsize=10

      walk  [label="parseBlockFromBuffer × numBlocks\nserial: each header locates the next"]
      uncmp [label="uncompressBlockContent\nper block, by its method byte"]
      ctx   [label="buildSliceDecodeContext\nJS data-series codecs: external, huffman,\nbeta, gamma, subexp, byteArray*"]
      recs  [label="decodeRecord × numRecords\n→ read-feature / tag / quality columns\nthen associateIntraSliceMates"]
    }

    ref [label="applyReferenceSequence — main thread only\nfetchReferenceSequence callback\n→ substitutions resolved, refRegion attached"]
  }

  subgraph cluster_wasm {
    label="WebAssembly — inlined in the bundle, lazy singleton per JS context"
    labelloc=b
    color="#b5793f" fontcolor="#b5793f" fontsize=10

    hts [label="htscodecs.wasm\ngzip (libdeflate), bzip2, rans,\nrans4x16, arith, fqzcomp, tok3" style="rounded,filled" fillcolor="#fdf0e4"]
    xz  [label="xz-embedded.wasm\nlzma" style="rounded,filled" fillcolor="#fdf0e4"]
  }

  query -> crai
  crai  -> cont  [label="  per slice, in parallel"]
  cont  -> cache
  cache -> req   [label="  miss"]
  req   -> walk  [label="  postMessage(sliceBytes, …)\n  or a direct call" lhead=cluster_decode]
  walk  -> uncmp
  uncmp -> ctx   [label="  decompressed blocks"]
  ctx   -> recs
  recs  -> ref   [label="  sliceTransfer — columns transferred at zero copy,\n  per-record scalars in one Int32Array (worker path)" ltail=cluster_decode]
  ref   -> out   [label="  decoded slice, cached"]
  cache -> out   [label="  hit: already decoded and decorated"]

  crai  -> hts   [style=dashed color="#b5793f" constraint=false]
  uncmp -> hts   [style=dashed color="#b5793f" constraint=false]
  uncmp -> xz    [style=dashed color="#b5793f" constraint=false]

  { rank=same; recs; hts; xz }
}
