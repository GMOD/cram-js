// Source for docs/img/dataflow.svg, which dataflow.md embeds.
// Regenerate with: dot -Tsvg docs/img/dataflow.dot -o docs/img/dataflow.svg
//
// Deliberately the MAIN PATH only, with short labels — the worker fallback, the
// zero-copy transfer, the reference callback, the .crai's own gunzip and the
// per-block wasm boundary are all explained in dataflow.md instead. A diagram
// that shows every branch stops being the thing you look at first.
//
// SYNC: ~/src/gmod/bam-js/docs/img/dataflow.dot — same palette, legend and
// spine. The two clusters are the one thing cram adds: what moves to a worker,
// and what is wasm. bam draws its pool as a single node off a dashed "optional"
// edge because only decompression moves; here the unit is the whole slice, so
// the pool has to be a box around several steps. Same term, different mark —
// and purple means the same thing in all three, which is why the pool is not
// drawn in the wasm orange it used to be.
digraph cramjs {
  rankdir=TB
  compound=true
  bgcolor="white"
  nodesep=0.3
  ranksep=0.36
  node [shape=box style="filled,rounded" fillcolor="#f6f8fa" color="#57606a"
        fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  query [label="getRecordsForRange(seqId, start, end)" fillcolor="#ddf4ff" color="#0969da"]
  crai  [label="read .crai" fillcolor="#dafbe1" color="#1a7f37"]
  cont  [label="read container header" fillcolor="#dafbe1" color="#1a7f37"]
  cache [label="featureCache" fillcolor="#fff8c5" color="#9a6700"]
  read  [label="read slice blocks" fillcolor="#dafbe1" color="#1a7f37"]
  ref   [label="applyReferenceSequence" fillcolor="#dafbe1" color="#1a7f37"]
  out   [label="CramRecord[]" fillcolor="#ddf4ff" color="#0969da"]

  subgraph cluster_decode {
    label="worker pool — whole slice, if available"
    fontname="Helvetica" fontsize=9 fontcolor="#8250df" color="#8250df"
    margin=10

    walk  [label="parse block headers"]
    uncmp [label="uncompress blocks" fillcolor="#ffd8b5" color="#bc4c00"]
    recs  [label="decode records\nJS data-series codecs"]
    cols  [label="read-feature arena,\ntag and quality columns"]
  }

  subgraph cluster_wasm {
    label="inlined, lazy singleton per JS context"
    labelloc=b
    fontname="Helvetica" fontsize=9 fontcolor="#bc4c00" color="#bc4c00"

    hts [label="htscodecs.wasm\ngzip, bzip2, rans, arith,\nfqzcomp, tok3" fillcolor="#ffd8b5" color="#bc4c00"]
    xz  [label="xz-embedded.wasm\nlzma" fillcolor="#ffd8b5" color="#bc4c00"]
    hts -> xz [style=invis]
  }

  query -> crai
  crai  -> cont  [label=" per slice, in parallel "]
  cont  -> cache
  cache -> read  [label=" miss "]
  read  -> walk  [lhead=cluster_decode]
  walk  -> uncmp
  uncmp -> recs
  recs  -> cols
  cols  -> ref   [ltail=cluster_decode]
  ref   -> out
  cache -> out   [label=" hit "]

  uncmp -> hts   [style=dashed color="#bc4c00" lhead=cluster_wasm]

  subgraph cluster_legend {
    label="Legend"
    labelloc="t"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    node [shape=box style="filled,rounded" fontsize=9 margin="0.1,0.04"]
    l1 [label="I/O" fillcolor="#dafbe1" color="#1a7f37"]
    l2 [label="wasm" fillcolor="#ffd8b5" color="#bc4c00"]
    l3 [label="cached / shared" fillcolor="#fff8c5" color="#9a6700"]
    l4 [label="off the main thread" fillcolor="#fbefff" color="#8250df"]
    l1 -> l2 -> l3 -> l4 [style=invis]
  }
}
